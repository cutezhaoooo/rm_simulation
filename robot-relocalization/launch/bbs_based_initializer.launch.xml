<launch>
  <!-- Configuration arguments -->
  <arg name="config_file" default="$(find-pkg-share bbs_based_initializer)/config/bbs_based_initializer.param.yaml"/>
  <arg name="node_name" default="bbs_based_initializer"/>
  <arg name="log_level" default="info"/>
  <arg name="output" default="both"/>
  
  <!-- Topic remapping arguments -->
  <arg name="lidar_topic" default="/lio_point_body"/>
  <arg name="map_topic" default="/localizer/map_cloud"/>
  <arg name="imu_topic" default="/livox/imu"/>
  <arg name="pose_topic" default="/initialpose"/>
  
  <!-- Launch the bbs_based_initializer node -->
  <node pkg="bbs_based_initializer" 
        exec="bbs_based_initializer" 
        name="$(var node_name)" 
        output="$(var output)"
        args="--ros-args --log-level $(var log_level)">
    
    <!-- Configuration parameter -->
    <param name="config" value="$(var config_file)"/>
    
    <!-- Topic remappings -->
    <remap from="/lio_point_body" to="$(var lidar_topic)"/>
    <remap from="/localizer/map_cloud" to="$(var map_topic)"/>
    <remap from="/livox/imu" to="$(var imu_topic)"/>
    <remap from="/initialpose" to="$(var pose_topic)"/>
  </node>
  
  <!-- Display launch information -->
  <group>
    <let name="config_info" value="Configuration file: $(var config_file)"/>
    <let name="topic_info" value="LiDAR: $(var lidar_topic), Map: $(var map_topic), IMU: $(var imu_topic), Pose: $(var pose_topic)"/>
  </group>
</launch>